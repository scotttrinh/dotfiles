#!/bin/sh

PLUGIN_DIR="$CONFIG_DIR/plugins"
. "$CONFIG_DIR/colors.sh"

FONT="Geist"
ICON_FONT="Symbols Nerd Font Mono"

sketchybar --bar \
  position=top \
  height=34 \
  blur_radius=24 \
  color="$BAR_COLOR" \
  border_width=1 \
  border_color="$BORDER_COLOR" \
  padding_left=8 \
  padding_right=8 \
  margin=4 \
  corner_radius=4

sketchybar --default \
  icon.font="$ICON_FONT:14.0" \
  icon.color="$MUTED_COLOR" \
  icon.padding_left=7 \
  icon.padding_right=5 \
  label.font="$FONT:Semibold:13.0" \
  label.color="$TEXT_COLOR" \
  label.padding_left=5 \
  label.padding_right=7 \
  background.height=24 \
  background.corner_radius=7 \
  background.color="$ITEM_BG_COLOR" \
  background.drawing=on \
  padding_left=3 \
  padding_right=3

sketchybar --add event aerospace_workspace_change

for workspace in 1 2 3 4 5; do
  sketchybar --add item "space.$workspace" left \
    --set "space.$workspace" \
      icon.drawing=off \
      label="$workspace" \
      label.padding_left=9 \
      label.padding_right=9 \
      click_script="aerospace workspace $workspace" \
      script="$PLUGIN_DIR/space.sh $workspace" \
    --subscribe "space.$workspace" aerospace_workspace_change
done

sketchybar --add item front_app left \
  --set front_app \
    icon="󰣆" \
    label="Finder" \
    background.drawing=off \
    click_script="open 'raycast://extensions/raycast/navigation/search-menu-items'" \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock \
    icon="󰃭" \
    update_freq=10 \
    click_script="open -a Dato" \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item vercel_spend right \
  --set vercel_spend \
    icon="▲" \
    label="…" \
    update_freq=0 \
    popup.align=right \
    popup.height=28 \
    popup.background.color="$BAR_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    click_script="sketchybar --set vercel_spend popup.drawing=toggle" \
    script="$PLUGIN_DIR/vercel_spend.sh"

sketchybar --add item vercel_spend.status popup.vercel_spend \
  --set vercel_spend.status \
    icon.drawing=off \
    label="Loading today's usage…" \
    label.color="$MUTED_COLOR" \
    background.drawing=off

for row in 1 2 3 4 5; do
  sketchybar --add item "vercel_spend.model.$row" popup.vercel_spend \
    --set "vercel_spend.model.$row" \
      drawing=off \
      icon.drawing=off \
      background.drawing=off
done

sketchybar --add item vercel_spend.refresh popup.vercel_spend \
  --set vercel_spend.refresh \
    icon="↻" \
    icon.color="$ACCENT_COLOR" \
    label="Refresh usage" \
    label.color="$ACCENT_COLOR" \
    background.drawing=off \
    click_script="sketchybar --set vercel_spend.status label='Refreshing…'; NAME=vercel_spend '$PLUGIN_DIR/vercel_spend.sh' &"

sketchybar --add item vercel_spend.dashboard popup.vercel_spend \
  --set vercel_spend.dashboard \
    icon="↗" \
    icon.color="$ACCENT_COLOR" \
    label="Open AI Gateway dashboard" \
    label.color="$ACCENT_COLOR" \
    background.drawing=off \
    click_script="open 'https://vercel.com/ai-gateway'; sketchybar --set vercel_spend popup.drawing=off"

sketchybar --add item battery right \
  --set battery \
    update_freq=60 \
    click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume \
    update_freq=10 \
    click_script="$PLUGIN_DIR/sound_panel.sh" \
    script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --update
